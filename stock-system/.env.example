# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# Free tier: https://newsapi.org/register  (100 req/day)
NEWS_API_KEY=your_newsapi_key_here

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./market.db

# ── LLM backend selector: "claude" | "vllm" ──────────────────────────────────
LLM_BACKEND=claude

# ── Anthropic (required when LLM_BACKEND=claude) ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── vLLM (required when LLM_BACKEND=vllm) ────────────────────────────────────
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Model artefact directory ──────────────────────────────────────────────────
# Defaults to ./models/  relative to stock-system/
MODELS_DIR=./models
