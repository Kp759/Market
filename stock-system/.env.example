# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# ── NewsAPI ───────────────────────────────────────────────────────────────────
# Free tier: https://newsapi.org/register  (100 req/day)
# If omitted, news is skipped gracefully and sentiment defaults to 0.0
NEWS_API_KEY=your_newsapi_key_here

# ── SEC EDGAR User-Agent (required by EDGAR TOS) ──────────────────────────────
# Format: "Company/App name contact@email.com"
EDGAR_USER_AGENT=MyApp research@example.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=./market.db

# ── LLM backend selector ──────────────────────────────────────────────────────
# "claude" → Anthropic API  |  "vllm" → self-hosted OpenAI-compatible endpoint
LLM_BACKEND=claude

# ── Anthropic (required when LLM_BACKEND=claude) ─────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── vLLM (required when LLM_BACKEND=vllm) ────────────────────────────────────
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Model artefact directory ──────────────────────────────────────────────────
# Default: ./models/  (relative to stock-system/)
MODELS_DIR=./models
