# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# NewsAPI key — free tier: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Path to the SQLite database file (relative or absolute)
DB_PATH=./market.db

# LLM backend selector: "claude" | "vllm"
LLM_BACKEND=claude

# Anthropic API key (required when LLM_BACKEND=claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# vLLM base URL (required when LLM_BACKEND=vllm)
VLLM_BASE_URL=http://localhost:8000/v1
